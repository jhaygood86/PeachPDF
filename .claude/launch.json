{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "demo",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--project",
        "src/PeachPDF.Demo.BlazorWasm/PeachPDF.Demo.BlazorWasm.csproj",
        "--launch-profile",
        "http"
      ],
      "port": 5068
    },
    {
      "name": "docs",
      "runtimeExecutable": "jekyll",
      "runtimeArgs": [
        "serve",
        "--source",
        "docs",
        "--port",
        "4000"
      ],
      "port": 4000
    }
  ]
}
