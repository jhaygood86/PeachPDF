<Project Sdk="Microsoft.NET.Sdk">

	<!--
	  PeachReader, the PDF reader app: a .NET MAUI single project. Pages are read by PeachDrawing.PDF (through PeachReader.Core) and drawn with the
	  native backend of each platform: Win2D on Windows (now), CoreGraphics on iOS and Mac Catalyst and Skia on Android (to come). Needs the
	  maui workloads, so it is not in PeachPDF.slnx; build the project itself.
	-->
	<PropertyGroup>
		<!-- Android is left out on a Mac unless asked for (-p:ReaderIncludeAndroid=true), since a Mac set up for the Apple heads rarely has the android workload and restore needs every target's workload. -->
		<TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('osx')) Or '$(ReaderIncludeAndroid)' == 'true'">net11.0-android</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net11.0-windows10.0.19041.0</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">$(TargetFrameworks);net11.0-ios;net11.0-maccatalyst</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<RootNamespace>PeachReader</RootNamespace>
		<AssemblyName>PeachReader</AssemblyName>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<IsPackable>false</IsPackable>
		<ApplicationTitle>PeachReader</ApplicationTitle>
		<ApplicationId>net.peachpdf.reader</ApplicationId>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">16.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">17.0</SupportedOSPlatformVersion>
		<WindowsPackageType>None</WindowsPackageType>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
		<Win2DWarnNoPlatform>false</Win2DWarnNoPlatform>
		<MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>
	</PropertyGroup>

	<ItemGroup>
		<!-- The repo manages package versions centrally; this one takes the version of the installed MAUI workload. -->
		<PackageReference Include="Microsoft.Maui.Controls" VersionOverride="$(MauiVersion)" />
		<ProjectReference Include="..\PeachReader.Core\PeachReader.Core.csproj" />
		<ProjectReference Include="..\..\drawing\PeachDrawing.PDF\PeachDrawing.PDF.csproj" />
		<ProjectReference Include="..\..\drawing\PeachDrawing.Core\PeachDrawing.Core.csproj" />
	</ItemGroup>

	<!-- Android draws with Skia on the GPU through SkiaSharp's own GL view (the same one PeachBrackets.Android uses), not the MAUI wrapper. -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<ProjectReference Include="..\..\drawing\PeachDrawing.Skia\PeachDrawing.Skia.csproj" />
		<PackageReference Include="SkiaSharp.Views" />
	</ItemGroup>

	<!-- iOS and Mac Catalyst draw with CoreGraphics into tile layers; the one UIKit view is shared (Platforms/Apple). -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' Or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
		<ProjectReference Include="..\..\drawing\PeachDrawing.CoreGraphics\PeachDrawing.CoreGraphics.csproj" />
	</ItemGroup>

	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
		<ProjectReference Include="..\..\drawing\PeachDrawing.Win2D\PeachDrawing.Win2D.csproj" />
		<PackageReference Include="Microsoft.Graphics.Win2D" />
	</ItemGroup>

	<!-- The MAUI SDK drops every Platforms folder that is not named for the head being built, so the folder the two Apple heads share is added just before compiling. -->
	<Target Name="AddSharedAppleSources" BeforeTargets="CoreCompile" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' Or $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
		<ItemGroup>
			<Compile Include="Platforms\Apple\**\*.cs" />
		</ItemGroup>
	</Target>

</Project>
