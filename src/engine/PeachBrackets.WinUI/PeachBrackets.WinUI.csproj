<Project Sdk="Microsoft.NET.Sdk">
	<Import Project="..\..\Version.props" />
	<PropertyGroup>
		<!-- Windows-only: a WinUI 3 control. -->
		<TargetFrameworks>net10.0-windows10.0.19041.0;net11.0-windows10.0.19041.0</TargetFrameworks>
		<SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
		<UseWinUI>true</UseWinUI>
		<EnableMsixTooling>true</EnableMsixTooling>
		<AssemblyName>PeachBrackets.WinUI</AssemblyName>
		<RootNamespace>PeachBrackets.WinUI</RootNamespace>
		<PackageId>PeachBrackets.WinUI</PackageId>
		<Description>A WinUI 3 control that shows an HTML document laid out by PeachBrackets: scrolling, zoom, links, text selection and copy, find, and the CSS cursor, hover and touch behaviour the document asks for.</Description>
		<PackageTags>html;css;winui;windows;control;viewer;rendering</PackageTags>
		<PackageIcon>peach.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageProjectUrl>https://peachpdf.net/</PackageProjectUrl>
		<RepositoryUrl>https://github.com/jhaygood86/PeachPDF.git</RepositoryUrl>
		<PackageLicenseExpression>BSD-3-Clause</PackageLicenseExpression>
		<IncludeSymbols>true</IncludeSymbols>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<GenerateAssemblyConfigurationAttribute>false</GenerateAssemblyConfigurationAttribute>
		<GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
		<GenerateAssemblyProductAttribute>false</GenerateAssemblyProductAttribute>
		<GenerateAssemblyInformationalVersionAttribute>false</GenerateAssemblyInformationalVersionAttribute>
		<GenerateAssemblyFileVersionAttribute>false</GenerateAssemblyFileVersionAttribute>
		<GenerateAssemblyTitleVersionAttribute>false</GenerateAssemblyTitleVersionAttribute>
		<GenerateAssemblyVersionAttribute>false</GenerateAssemblyVersionAttribute>
		<Win2DWarnNoPlatform>false</Win2DWarnNoPlatform>
	</PropertyGroup>
	<ItemGroup>
		<ProjectReference Include="..\PeachBrackets\PeachBrackets.csproj" />
		<ProjectReference Include="..\..\drawing\PeachDrawing.Core\PeachDrawing.Core.csproj" />
		<ProjectReference Include="..\..\drawing\PeachDrawing.Win2D\PeachDrawing.Win2D.csproj" />
		<!-- Only the parts of the Windows App SDK the control compiles against, not the all-in-one package, which brings the AI, ML, Search and Widgets components with it. -->
		<PackageReference Include="Microsoft.WindowsAppSDK.Base" />
		<PackageReference Include="Microsoft.WindowsAppSDK.Foundation" />
		<PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" />
		<PackageReference Include="Microsoft.WindowsAppSDK.WinUI" />
		<PackageReference Include="Microsoft.Graphics.Win2D" />
	</ItemGroup>
	<ItemGroup>
		<InternalsVisibleTo Include="PeachBrackets.WinUI.Tests" />
		<InternalsVisibleTo Include="PeachBrackets.WinUI.UITests" />
		<InternalsVisibleTo Include="PeachBrackets.WinUI.Example" />
	</ItemGroup>
	<ItemGroup>
		<None Include="..\..\..\LICENSE" Pack="true" PackagePath="\" />
		<None Include="..\..\..\docs\assets\img\peach.png" Pack="true" PackagePath="\" />
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>
</Project>
