<Project Sdk="Microsoft.NET.Sdk">
	<Import Project="..\..\Version.props" />
	<Import Project="..\..\ApiReference.props" />
	<PropertyGroup>
		<!-- Apple platforms only: needs the macos and ios workloads, so it is not in PeachPDF.slnx (like PeachBrackets.Android). The repo-wide net8.0 target is dropped on purpose. -->
		<TargetFrameworks>net10.0-macos;net10.0-ios</TargetFrameworks>
		<TargetFrameworks Condition="'$(ResolvedNETCoreSdkVersionLooksVersioned)' == 'true' AND $([MSBuild]::VersionGreaterThanOrEquals($(ResolvedNETCoreSdkVersion), '11.0.100'))">$(TargetFrameworks);net11.0-macos;net11.0-ios</TargetFrameworks>
		<AssemblyName>PeachDrawing.CoreGraphics</AssemblyName>
		<RootNamespace>PeachDrawing.CoreGraphics</RootNamespace>
		<PackageId>PeachDrawing.CoreGraphics</PackageId>
		<Description>A CoreGraphics Canvas for PeachDrawing.Core - draw shapes, gradients, clips, layers, text and images with Apple's CoreGraphics into a caller's CGContext or an offscreen bitmap on macOS and iOS, with Core Image effects on the GPU, clickable links, and no PDF, HTML or CSS involved.</Description>
		<PackageTags>drawing;graphics;canvas;coregraphics;quartz;metal;macos;ios;rendering</PackageTags>
		<PackageIcon>peach.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageProjectUrl>https://peachpdf.net/</PackageProjectUrl>
		<RepositoryUrl>https://github.com/jhaygood86/PeachPDF.git</RepositoryUrl>
		<PackageLicenseExpression>BSD-3-Clause</PackageLicenseExpression>
		<IncludeSymbols>true</IncludeSymbols>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<GenerateAssemblyConfigurationAttribute>false</GenerateAssemblyConfigurationAttribute>
		<GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
		<GenerateAssemblyProductAttribute>false</GenerateAssemblyProductAttribute>
		<GenerateAssemblyInformationalVersionAttribute>false</GenerateAssemblyInformationalVersionAttribute>
		<GenerateAssemblyFileVersionAttribute>false</GenerateAssemblyFileVersionAttribute>
		<GenerateAssemblyTitleVersionAttribute>false</GenerateAssemblyTitleVersionAttribute>
		<GenerateAssemblyTitleAttribute>false</GenerateAssemblyTitleAttribute>
		<GenerateAssemblyVersionAttribute>false</GenerateAssemblyVersionAttribute>
		<RunCodeAnalysis>false</RunCodeAnalysis>
		<!-- The [LibraryImport] declarations in Interop/ are source generated and take pointers. -->
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>
	<ItemGroup>
		<ProjectReference Include="..\PeachDrawing.Core\PeachDrawing.Core.csproj" />
		<ProjectReference Include="..\PeachDrawing\PeachDrawing.csproj" />
		<PackageReference Include="PeachImage" />
	</ItemGroup>
	<ItemGroup>
		<InternalsVisibleTo Include="PeachDrawing.CoreGraphics.Tests" />
	</ItemGroup>
	<ItemGroup>
		<None Include="..\..\..\LICENSE" Pack="true" PackagePath="\" />
		<None Include="..\..\..\docs\assets\img\peach.png" Pack="true" PackagePath="\" />
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="THIRD-PARTY-LICENSES.md" Pack="true" PackagePath="\" />
	</ItemGroup>
</Project>
