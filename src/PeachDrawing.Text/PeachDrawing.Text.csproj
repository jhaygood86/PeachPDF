<Project Sdk="Microsoft.NET.Sdk">
	<Import Project="..\Version.props" />
	<PropertyGroup>
		<AssemblyName>PeachDrawing.Text</AssemblyName>
		<RootNamespace>PeachDrawing.Text</RootNamespace>
		<PackageId>PeachDrawing.Text</PackageId>
		<Description>Font loading and matching, OpenType shaping (including variable fonts, colour glyphs and SVG glyphs), bidirectional text, Unicode line breaking and segmentation, and paragraph layout for .NET, with no dependencies. The text engine PeachPDF renders HTML with.</Description>
		<PackageTags>fonts;opentype;truetype;woff;text;shaping;bidi;unicode;hyphenation;typography</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>peach.png</PackageIcon>
		<PackageProjectUrl>https://peachpdf.net/</PackageProjectUrl>
		<RepositoryUrl>https://github.com/jhaygood86/PeachPDF.git</RepositoryUrl>
		<PackageLicenseExpression>BSD-3-Clause</PackageLicenseExpression>
		<IncludeSymbols>true</IncludeSymbols>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<GenerateAssemblyConfigurationAttribute>false</GenerateAssemblyConfigurationAttribute>
		<GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
		<GenerateAssemblyProductAttribute>false</GenerateAssemblyProductAttribute>
		<GenerateAssemblyInformationalVersionAttribute>false</GenerateAssemblyInformationalVersionAttribute>
		<GenerateAssemblyFileVersionAttribute>false</GenerateAssemblyFileVersionAttribute>
		<GenerateAssemblyTitleVersionAttribute>false</GenerateAssemblyTitleVersionAttribute>
		<GenerateAssemblyTitleAttribute>false</GenerateAssemblyTitleAttribute>
		<GenerateAssemblyVersionAttribute>false</GenerateAssemblyVersionAttribute>
		<RunCodeAnalysis>false</RunCodeAnalysis>
		<IsTrimmable>true</IsTrimmable>
		<EnableTrimAnalyzer>true</EnableTrimAnalyzer>
		<IsAotCompatible>true</IsAotCompatible>
		<!-- The LibraryImport source generator emits unsafe marshalling code (SYSLIB1062) for the fontconfig binding. No hand-written unsafe blocks exist in this project. -->
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>
	<ItemGroup>
		<!-- Unicode and hyphenation data, read back by name through this assembly's own manifest resources. -->
		<None Remove="Internal\Text\Resources\Patterns\*.br" />
		<EmbeddedResource Include="Internal\Text\Resources\Patterns\*.br" />
		<None Remove="Internal\Text\Resources\language-tags.txt" />
		<EmbeddedResource Include="Internal\Text\Resources\language-tags.txt" />
		<None Remove="Internal\Text\Resources\opentype-language-tags.txt" />
		<EmbeddedResource Include="Internal\Text\Resources\opentype-language-tags.txt" />
		<None Remove="Internal\Text\Resources\Bidi\*.br" />
		<EmbeddedResource Include="Internal\Text\Resources\Bidi\*.br" />
		<None Remove="Internal\Text\Resources\VerticalOrientation\*.br" />
		<EmbeddedResource Include="Internal\Text\Resources\VerticalOrientation\*.br" />
		<None Remove="Internal\Text\Resources\Script\*.br" />
		<EmbeddedResource Include="Internal\Text\Resources\Script\*.br" />
		<None Remove="Internal\Text\Resources\ArabicJoining\*.br" />
		<EmbeddedResource Include="Internal\Text\Resources\ArabicJoining\*.br" />
		<None Remove="Internal\Text\Resources\Use\*.br" />
		<EmbeddedResource Include="Internal\Text\Resources\Use\*.br" />
	</ItemGroup>
	<ItemGroup>
		<!--
			PeachPDF reads only this library's public API, and the compiler enforces it: there is no InternalsVisibleTo
			for PeachPDF. What remains is a TEMPORARY bridge for the engine's own tests, which still live in
			PeachPDF.Tests. It goes when they move to a test project of this library.
		-->
		<InternalsVisibleTo Include="PeachPDF.Tests" />
		<InternalsVisibleTo Include="PeachDrawing.Text.Tests" />
	</ItemGroup>
	<ItemGroup>
		<!-- The notices the licences of the code and data in this package require it to carry. -->
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="THIRD-PARTY-LICENSES.md" Pack="true" PackagePath="\" />
		<None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
		<None Include="..\..\docs\assets\img\peach.png" Pack="true" PackagePath="\" />
	</ItemGroup>
</Project>
