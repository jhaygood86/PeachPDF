<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The tests of the PDF writer: its public API written the way a consumer of the NuGet package uses it (PdfComposerTests), and the engine and
    canvas internals this project is granted (InternalsVisibleTo) - the object model, the content-stream renderer, fonts, images, encodings.
    Nothing here may reference PeachPDF. A test that needs HTML, CSS or SVG layout, or reads a document PeachPDF produced, stays in
    PeachPDF.Tests and inspects the saved bytes.
  -->
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.MTP" />
    <PackageReference Include="System.Text.Encoding.CodePages" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
    <PackageReference Include="xunit.analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PeachDrawing.PDF\PeachDrawing.PDF.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared with the sibling test projects - see PeachDrawing.Tests.csproj's own precedent. -->
    <Compile Include="..\PeachPDF.Tests\TestSupport\BundledFonts.cs" Link="TestSupport\BundledFonts.cs" />
    <Compile Include="..\PeachPDF.Tests\TestSupport\BitmapGlyphFontFixture.cs" Link="TestSupport\BitmapGlyphFontFixture.cs" />
    <Compile Include="..\PeachPDF.Tests\TestSupport\RasterPngFixture.cs" Link="TestSupport\RasterPngFixture.cs" />
    <Compile Include="..\PeachPDF.Tests\TestSupport\TypefaceFixtures.cs" Link="TestSupport\TypefaceFixtures.cs" />
    <Compile Include="..\PeachPDF.Tests\TestSupport\IccProfileFixture.cs" Link="TestSupport\IccProfileFixture.cs" />
    <Compile Include="..\PeachPDF.Tests\TestSupport\RasterGifFixture.cs" Link="TestSupport\RasterGifFixture.cs" />
    <Compile Include="..\PeachPDF.Tests\TestSupport\TestFonts.cs" Link="TestSupport\TestFonts.cs" />
    <Compile Include="..\PeachPDF.Tests\TestSupport\JxlFixtures.cs" Link="TestSupport\JxlFixtures.cs" />
    <Compile Include="..\PeachPDF.Tests\TestSupport\CmykTiffFixture.cs" Link="TestSupport\CmykTiffFixture.cs" />
    <Compile Include="..\PeachPDF.Tests\TestSupport\PathPoints.cs" Link="TestSupport\PathPoints.cs" />
    <Compile Include="..\PeachPDF.Tests\TestSupport\SyntheticFontTables.cs" Link="TestSupport\SyntheticFontTables.cs" />
    <Compile Include="..\PeachPDF.Tests\TestSupport\SfntByteBuilder.cs" Link="TestSupport\SfntByteBuilder.cs" />
    <Compile Include="..\PeachPDF.Tests\TestSupport\CmykJpegFixture.cs" Link="TestSupport\CmykJpegFixture.cs" />
    <Compile Include="..\PeachPDF.Tests\TestSupport\AllocationProbe.cs" Link="TestSupport\AllocationProbe.cs" />
    <Compile Include="..\PeachPDF.Tests\TestSupport\RgbTiffFixture.cs" Link="TestSupport\RgbTiffFixture.cs" />
  </ItemGroup>

  <!--
    Small JPEG XL fixtures (PeachImage has no JPEG XL encoder, so they are committed files), copied
    from PeachImage v0.5.0's own test assets (BSD-3-Clause, see TestSupport/Jxl/README.md).
  -->
  <ItemGroup>
    <None Include="..\PeachPDF.Tests\TestSupport\Jxl\*.jxl" LinkBase="TestSupport\Jxl">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!--
    Font assets live in the repository-root assets/fonts/ directory, shared with
    PeachPDF.TestHarness and PeachPDF.Demo.BlazorWasm so the same file isn't checked in several
    times. Each is <Link>ed to the output root, so BundledFonts' AppContext.BaseDirectory lookups
    are unchanged. Listed one by one rather than globbed, so this project still declares exactly
    which fonts it needs and an unrelated asset can't silently bloat the test output.
  -->
  <ItemGroup>
    <None Include="..\..\assets\fonts\Inter-Medium.woff2" Link="Inter-Medium.woff2">
