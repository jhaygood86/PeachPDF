<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The tests of the drawing-surface abstraction: geometry, paint-object construction and GraphicsPath
    flattening, exercised through the public API and, where a test-double Canvas/RenderContext/GraphicsPath
    subclass is needed, through internals the project grants this test project (InternalsVisibleTo). Nothing
    here may reference PeachPDF.
  -->
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.MTP" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
    <PackageReference Include="xunit.analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\drawing\PeachDrawing.Core\PeachDrawing.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The one bundled font TypefaceFontTests needs for a real Typeface to build metrics from. -->
    <None Include="..\..\..\assets\fonts\SourceSans3-Regular.ttf" Link="SourceSans3-Regular.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
