<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests of the macOS HtmlView in a real (offscreen) window: it loads documents, paints tiles that are read back as pixels, takes mouse and key events the way the window
    would deliver them, and exposes accessibility elements. The AppKit run loop has to be running for that (timers, main-thread callbacks and the view's async continuations
    all need it), so Program.cs runs NSApplication on the main thread and the tests on a worker, and the harness hands view work to the main thread. Apple-only; run it with
    run.sh; not in PeachPDF.slnx. The platform-free logic is tested by PeachBrackets.Apple.Tests, which runs everywhere.
  -->
  <PropertyGroup>
    <TargetFrameworks>net10.0-macos</TargetFrameworks>
    <ApplicationId>net.peachpdf.brackets.apple.apptests</ApplicationId>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <XunitAutoGeneratedEntryPoint>false</XunitAutoGeneratedEntryPoint>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <IsTrimmable>false</IsTrimmable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
    <PackageReference Include="xunit.analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\engine\PeachBrackets.Apple\PeachBrackets.Apple.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- The macOS SDK turns the .NET app host off, and xunit.v3 refuses to build without it; only its check needs to see the property. -->
  <Target Name="AllowXunitOnTheAppBundle" BeforeTargets="_XunitValidateBuild">
    <PropertyGroup>
      <UseAppHost>true</UseAppHost>
    </PropertyGroup>
  </Target>
  <Target Name="RestoreTheOffAppHost" AfterTargets="_XunitValidateBuild">
    <PropertyGroup>
      <UseAppHost>false</UseAppHost>
    </PropertyGroup>
  </Target>

</Project>
