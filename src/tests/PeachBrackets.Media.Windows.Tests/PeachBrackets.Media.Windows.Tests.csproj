<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The tests of the Windows media provider: clips played through the real Windows media stack into Win2D bitmaps on a software device.
    Windows-only, because the provider is. Clips are small H.264 files in Assets.
  -->
  <PropertyGroup>
    <TargetFrameworks>net10.0-windows10.0.19041.0</TargetFrameworks>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.MTP" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
    <PackageReference Include="xunit.analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\engine\PeachBrackets.Media.Windows\PeachBrackets.Media.Windows.csproj" />
    <ProjectReference Include="..\..\drawing\PeachDrawing.Win2D\PeachDrawing.Win2D.csproj" />
    <ProjectReference Include="..\..\engine\PeachBrackets.Media.Platform\PeachBrackets.Media.Platform.csproj" />
    <ProjectReference Include="..\..\drawing\PeachDrawing\PeachDrawing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Assets\*.mp4" CopyToOutputDirectory="PreserveNewest" LinkBase="Assets" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
