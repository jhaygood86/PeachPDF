<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The tests of the CoreGraphics backend: what a CoreGraphicsCanvas draws for each Canvas call, read back as pixels from a bitmap context, the
    composer, both text engines and image codecs, the resource-lifecycle counters, links, and the public-API/internals-grant snapshot tests.
    Apple-only, because CoreGraphics is: the project runs as a macOS app bundle (the macOS SDK builds every executable as one), and is not in
    PeachPDF.slnx. It never references PeachPDF.
  -->
  <PropertyGroup>
    <TargetFrameworks>net10.0-macos</TargetFrameworks>
    <ApplicationId>net.peachpdf.coregraphics.tests</ApplicationId>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- The generated entry point blocks the main thread on an async method; a macOS app's main thread has a synchronization context that needs it free, so Program.cs runs the tests on a pool thread. -->
    <XunitAutoGeneratedEntryPoint>false</XunitAutoGeneratedEntryPoint>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <IsTrimmable>false</IsTrimmable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.MTP" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
    <PackageReference Include="xunit.analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\drawing\PeachDrawing.CoreGraphics\PeachDrawing.CoreGraphics.csproj" />
    <!-- The HTML engine's public API only, for the tests that draw real documents onto a CoreGraphicsCanvas. -->
    <ProjectReference Include="..\..\engine\PeachBrackets\PeachBrackets.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared with PeachDrawing.Tests/PeachPDF.Tests. -->
    <Compile Include="..\PeachPDF.Tests\TestSupport\BundledFonts.cs" Link="TestSupport\BundledFonts.cs" />
  </ItemGroup>

  <ItemGroup>
    <None PublishFolderType="Assembly" Include="..\..\..\assets\fonts\SourceSans3-Regular.ttf" Link="SourceSans3-Regular.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None PublishFolderType="Assembly" Include="..\..\..\assets\fonts\SourceCodePro-Regular.otf" Link="SourceCodePro-Regular.otf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None PublishFolderType="Assembly" Include="..\..\..\assets\fonts\ColorTestV0.ttf" Link="ColorTestV0.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None PublishFolderType="Assembly" Include="..\..\..\assets\fonts\NotoSansJPSubset.ttf" Link="NotoSansJPSubset.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None PublishFolderType="Assembly" Include="..\..\..\assets\fonts\StixTwoMath-Regular.ttf" Link="StixTwoMath-Regular.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None PublishFolderType="Assembly" Include="..\..\..\assets\fonts\SimonCozensCBDT.otf" Link="SimonCozensCBDT.otf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None PublishFolderType="Assembly" Include="..\..\..\assets\fonts\SimonCozensCffAndSbix.otf" Link="SimonCozensCffAndSbix.otf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None PublishFolderType="Assembly" Include="..\..\..\assets\fonts\SvgTest.ttf" Link="SvgTest.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None PublishFolderType="Assembly" Include="..\..\..\assets\fonts\ColorTestV1.ttf" Link="ColorTestV1.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>


  <!-- The macOS SDK turns the .NET app host off (it launches the app from its own bundle), and xunit.v3 refuses to build without it; the
       bundle's executable is what runs the tests, so only the check needs to see the property. -->
  <Target Name="AllowXunitOnTheAppBundle" BeforeTargets="_XunitValidateBuild">
    <PropertyGroup>
      <UseAppHost>true</UseAppHost>
    </PropertyGroup>
  </Target>
  <Target Name="RestoreTheOffAppHost" AfterTargets="_XunitValidateBuild">
    <PropertyGroup>
      <UseAppHost>false</UseAppHost>
    </PropertyGroup>
  </Target>

</Project>
