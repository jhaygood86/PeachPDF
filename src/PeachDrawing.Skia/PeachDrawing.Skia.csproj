<Project Sdk="Microsoft.NET.Sdk">
	<Import Project="..\Version.props" />
	<Import Project="..\ApiReference.props" />
	<PropertyGroup>
		<AssemblyName>PeachDrawing.Skia</AssemblyName>
		<RootNamespace>PeachDrawing.Skia</RootNamespace>
		<PackageId>PeachDrawing.Skia</PackageId>
		<Description>A SkiaSharp Canvas for PeachDrawing.Core - draw shapes, gradients, clips, layers, text and images with Skia, hardware accelerated when the surface you supply is, into a canvas you already have, with clickable links and no PDF, HTML or CSS involved.</Description>
		<PackageTags>drawing;graphics;canvas;skia;skiasharp;gpu;rendering</PackageTags>
		<PackageIcon>peach.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageProjectUrl>https://peachpdf.net/</PackageProjectUrl>
		<RepositoryUrl>https://github.com/jhaygood86/PeachPDF.git</RepositoryUrl>
		<PackageLicenseExpression>BSD-3-Clause</PackageLicenseExpression>
		<IncludeSymbols>true</IncludeSymbols>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<GenerateAssemblyConfigurationAttribute>false</GenerateAssemblyConfigurationAttribute>
		<GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
		<GenerateAssemblyProductAttribute>false</GenerateAssemblyProductAttribute>
		<GenerateAssemblyInformationalVersionAttribute>false</GenerateAssemblyInformationalVersionAttribute>
		<GenerateAssemblyFileVersionAttribute>false</GenerateAssemblyFileVersionAttribute>
		<GenerateAssemblyTitleVersionAttribute>false</GenerateAssemblyTitleVersionAttribute>
		<GenerateAssemblyTitleAttribute>false</GenerateAssemblyTitleAttribute>
		<GenerateAssemblyVersionAttribute>false</GenerateAssemblyVersionAttribute>
		<RunCodeAnalysis>false</RunCodeAnalysis>
	</PropertyGroup>
	<ItemGroup>
		<ProjectReference Include="..\PeachDrawing.Core\PeachDrawing.Core.csproj" />
		<!-- PeachDrawing supplies the raster fallback (RasterSurfaceFactory) for the few effects Skia has no equivalent for. -->
		<ProjectReference Include="..\PeachDrawing\PeachDrawing.csproj" />
		<PackageReference Include="PeachImage" />
		<!-- The application referencing this package picks the SkiaSharp native binaries for the platforms it ships to. -->
		<PackageReference Include="SkiaSharp" />
	</ItemGroup>
	<ItemGroup>
		<InternalsVisibleTo Include="PeachDrawing.Skia.Tests" />
		<!--
			Nothing else is granted access: a host (PeachPDF's test harness, the example) uses this package through its public API only.
			PublicApi/PublicSurfaceTests pins the granted set.
		-->
	</ItemGroup>
	<ItemGroup>
		<None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
		<None Include="..\..\docs\assets\img\peach.png" Pack="true" PackagePath="\" />
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="THIRD-PARTY-LICENSES.md" Pack="true" PackagePath="\" />
	</ItemGroup>
</Project>
