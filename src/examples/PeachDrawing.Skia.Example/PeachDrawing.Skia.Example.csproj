<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A console app that draws a handful of scenes with PeachDrawing.Skia alone - no PeachPDF, no HTML, no PDF - and writes each as a PNG
    file. It is the "how do I use the package" sample (docs/peachdrawing-skia.md walks through it). It supplies its own CPU surface; a
    phone app would hand the package the canvas of a GPU view instead, and nothing else would change.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks></TargetFrameworks>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\drawing\PeachDrawing.Skia\PeachDrawing.Skia.csproj" />
    <!-- The native Skia binaries for the machines this sample runs on; the library itself leaves that choice to the application. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
  </ItemGroup>

  <!-- The font the text scene draws with, so the output is the same on every machine. -->
  <ItemGroup>
    <None Include="..\..\..\assets\fonts\SourceSans3-Regular.ttf" Link="SourceSans3-Regular.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
