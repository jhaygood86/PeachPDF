<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A desktop app with an HtmlView: a list of the showcases on the left (filtered by category), the page in the middle, and a panel of settings on the right that turn the
    view's options on and off. The smoke option loads a page, prints what the view and document report and exits; the screenshot option pictures one showcase.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <TargetFrameworks />
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <!-- Rewrites a page fetched from the web (its root classes and base address) before the view loads it; see PageRewriter. Demo only, not shipped. -->
    <PackageReference Include="AngleSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\views\PeachBrackets.Avalonia\PeachBrackets.Avalonia.csproj" />
    <!-- The catalog, the sample page and the web page helpers the other demos share. -->
    <Compile Include="..\PeachBrackets.Apple.Demo.Shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The screen-only showcases shared with the other demos. -->
  <ItemGroup>
    <None Include="..\ScreenShowcases\**\*" Link="screen\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!--
    Every showcase of the PDF harness as HTML only (the harness option html-only), so the demo keeps no copy of them. The harness is run once into obj/showcases, and again when
    its Program.cs changes. Set SkipShowcaseExport=true to build without the harness showcases.
  -->
  <PropertyGroup>
    <ShowcaseExportDir>$(MSBuildProjectDirectory)/obj/showcases/</ShowcaseExportDir>
  </PropertyGroup>
  <Target Name="ExportHarnessShowcases" Condition="'$(SkipShowcaseExport)' != 'true'"
          Inputs="..\..\harness\PeachPDF.TestHarness\Program.cs" Outputs="$(ShowcaseExportDir)showcases.json">
    <Exec Command="dotnet run --project &quot;$(MSBuildProjectDirectory)/../../harness/PeachPDF.TestHarness/PeachPDF.TestHarness.csproj&quot; -f net10.0 -- --html-only &quot;$(ShowcaseExportDir.TrimEnd('/'))&quot;" />
  </Target>
  <Target Name="StageHarnessShowcases" BeforeTargets="BeforeBuild" DependsOnTargets="ExportHarnessShowcases">
    <ItemGroup>
      <HarnessShowcaseFile Include="$(ShowcaseExportDir)**/*" />
      <None Include="@(HarnessShowcaseFile)" Link="showcases/%(HarnessShowcaseFile.RecursiveDir)%(HarnessShowcaseFile.Filename)%(HarnessShowcaseFile.Extension)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
