<Project Sdk="Microsoft.NET.Sdk">

  <!--
    An iOS app with one UIView that draws with PeachDrawing.CoreGraphics into the CGContext UIKit hands its Draw method, then checks the same
    drawing by pixel in a bitmap context and prints PEACH_SMOKE lines to the device log. It is the library's iOS smoke test: run it in the
    simulator with run.sh. Not in PeachPDF.slnx (needs the ios workload).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0-ios</TargetFrameworks>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier>iossimulator-arm64</RuntimeIdentifier>
    <ApplicationId>net.peachpdf.coregraphics.ios</ApplicationId>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\drawing\PeachDrawing.CoreGraphics\PeachDrawing.CoreGraphics.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\PeachDrawing.CoreGraphics.Example\LoremScene.cs" Link="LoremScene.cs" />
  </ItemGroup>

  <ItemGroup>
    <BundleResource Include="..\..\..\assets\fonts\SourceSans3-Regular.ttf" Link="SourceSans3-Regular.ttf" />
  </ItemGroup>

</Project>
