<Project Sdk="Microsoft.NET.Sdk">
	<Import Project="..\Version.props" />
	<Import Project="..\ApiReference.props" />
	<PropertyGroup>
		<AssemblyName>PeachDrawing.Core</AssemblyName>
		<RootNamespace>PeachDrawing.Core</RootNamespace>
		<PackageId>PeachDrawing.Core</PackageId>
		<Description>The drawing-surface abstraction (Canvas, RenderContext, Brush, Pen, Font, Image, GraphicsPath and the paint-ready value types) PeachPDF targets to write PDF. A user of PeachDrawing.Core can build their own render target the same way PeachPDF targets it to PDF, or take PeachDrawing's own raster Canvas implementation.</Description>
		<PackageTags>drawing;graphics;canvas;rendering-abstraction</PackageTags>
		<PackageIcon>peach.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageProjectUrl>https://peachpdf.net/</PackageProjectUrl>
		<RepositoryUrl>https://github.com/jhaygood86/PeachPDF.git</RepositoryUrl>
		<PackageLicenseExpression>BSD-3-Clause</PackageLicenseExpression>
		<IncludeSymbols>true</IncludeSymbols>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<GenerateAssemblyConfigurationAttribute>false</GenerateAssemblyConfigurationAttribute>
		<GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
		<GenerateAssemblyProductAttribute>false</GenerateAssemblyProductAttribute>
		<GenerateAssemblyInformationalVersionAttribute>false</GenerateAssemblyInformationalVersionAttribute>
		<GenerateAssemblyFileVersionAttribute>false</GenerateAssemblyFileVersionAttribute>
		<GenerateAssemblyTitleVersionAttribute>false</GenerateAssemblyTitleVersionAttribute>
		<GenerateAssemblyTitleAttribute>false</GenerateAssemblyTitleAttribute>
		<GenerateAssemblyVersionAttribute>false</GenerateAssemblyVersionAttribute>
		<RunCodeAnalysis>false</RunCodeAnalysis>
		<IsTrimmable>true</IsTrimmable>
		<EnableTrimAnalyzer>true</EnableTrimAnalyzer>
		<IsAotCompatible>true</IsAotCompatible>
	</PropertyGroup>
	<ItemGroup>
		<ProjectReference Include="..\PeachDrawing.Text\PeachDrawing.Text.csproj" />
	</ItemGroup>
	<ItemGroup>
		<InternalsVisibleTo Include="PeachDrawing.Core.Tests" />
		<!--
			PeachPDF and PeachPDF.Tests are deliberately NOT granted access: PeachPDF drives this package through
			its public API only, exactly as any other consumer would. The one sibling grant is PeachDrawing, the
			software-raster Canvas implementation that ships alongside this package and shares its pixel buffers
			(RasterSurface.Buffer) and font plumbing (FontsHandler). PublicApi/InternalsGrantTests pins the exact set.
		-->
		<InternalsVisibleTo Include="PeachDrawing" />
	</ItemGroup>
	<ItemGroup>
		<None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
		<None Include="..\..\docs\assets\img\peach.png" Pack="true" PackagePath="\" />
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>
</Project>
