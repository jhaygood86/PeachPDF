<Project Sdk="Microsoft.NET.Sdk">
	<Import Project="..\Version.props" />
	<Import Project="..\ApiReference.props" />
	<PropertyGroup>
		<AssemblyName>PeachDrawing.PDF</AssemblyName>
		<RootNamespace>PeachDrawing.PDF</RootNamespace>
		<PackageId>PeachDrawing.PDF</PackageId>
		<Description>A PDF Canvas for PeachDrawing.Core: draw shapes, text, images, gradients and effects and write them as PDF, with fonts embedded and subset, PDF/A and PDF/X conformance, encryption and tagged output, in pure .NET.</Description>
		<PackageTags>pdf;drawing;graphics;canvas;rendering</PackageTags>
		<PackageIcon>peach.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageProjectUrl>https://peachpdf.net/</PackageProjectUrl>
		<RepositoryUrl>https://github.com/jhaygood86/PeachPDF.git</RepositoryUrl>
		<PackageLicenseExpression>BSD-3-Clause</PackageLicenseExpression>
		<IncludeSymbols>true</IncludeSymbols>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<GenerateAssemblyConfigurationAttribute>false</GenerateAssemblyConfigurationAttribute>
		<GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
		<GenerateAssemblyProductAttribute>false</GenerateAssemblyProductAttribute>
		<GenerateAssemblyInformationalVersionAttribute>false</GenerateAssemblyInformationalVersionAttribute>
		<GenerateAssemblyFileVersionAttribute>false</GenerateAssemblyFileVersionAttribute>
		<GenerateAssemblyTitleVersionAttribute>false</GenerateAssemblyTitleVersionAttribute>
		<GenerateAssemblyTitleAttribute>false</GenerateAssemblyTitleAttribute>
		<GenerateAssemblyVersionAttribute>false</GenerateAssemblyVersionAttribute>
		<RunCodeAnalysis>false</RunCodeAnalysis>
		<IsTrimmable>true</IsTrimmable>
		<EnableTrimAnalyzer>true</EnableTrimAnalyzer>
		<IsAotCompatible>true</IsAotCompatible>
		<!-- The LibraryImport source generator emits unsafe marshalling code (SYSLIB1062). No hand-written unsafe blocks exist in this project. -->
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>
	<ItemGroup>
		<ProjectReference Include="..\PeachDrawing\PeachDrawing.csproj" />
		<ProjectReference Include="..\PeachDrawing.Core\PeachDrawing.Core.csproj" />
		<ProjectReference Include="..\PeachDrawing.Text\PeachDrawing.Text.csproj" />
		<PackageReference Include="PeachImage" />
	</ItemGroup>
	<ItemGroup>
		<None Remove="Engine\Resources\ColorProfiles\sRGB2014.icc" />
		<EmbeddedResource Include="Engine\Resources\ColorProfiles\sRGB2014.icc" />
	</ItemGroup>
	<ItemGroup>
		<InternalsVisibleTo Include="PeachDrawing.PDF.Tests" />
		<!--
			TEMPORARY, while PeachPDF is moved onto this package's public API: PeachPDF and its tests still drive the PDF writer
			directly. PublicApi/InternalsGrantTests pins the set, and each step of the move removes a dependence; the end state
			grants nothing but PeachDrawing.PDF.Tests.
		-->
		<InternalsVisibleTo Include="PeachPDF" />
		<InternalsVisibleTo Include="PeachPDF.Tests" />
	</ItemGroup>
	<ItemGroup>
		<None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
		<None Include="..\..\docs\assets\img\peach.png" Pack="true" PackagePath="\" />
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="THIRD-PARTY-LICENSES.md" Pack="true" PackagePath="\" />
	</ItemGroup>
</Project>
