<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<AssemblyName>PeachPDF</AssemblyName>
		<PackageId>PeachPDF</PackageId>
		<PackageVersion>0.9.12</PackageVersion>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>peach.png</PackageIcon>
		<IncludeSymbols>true</IncludeSymbols>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
		<!-- Off by default so ordinary local `dotnet build` runs stay fast; CI passes -p:DisableDefaultDocumentation=false to regenerate docs/api/. -->
		<DisableDefaultDocumentation Condition="'$(DisableDefaultDocumentation)' == ''">true</DisableDefaultDocumentation>
		<DefaultDocumentationFolder>$(MSBuildProjectDirectory)/../../docs/api</DefaultDocumentationFolder>
		<DefaultDocumentationGeneratedAccessModifiers>Public</DefaultDocumentationGeneratedAccessModifiers>
		<DefaultDocumentationFileNameFactory>Name</DefaultDocumentationFileNameFactory>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<GenerateAssemblyConfigurationAttribute>false</GenerateAssemblyConfigurationAttribute>
		<GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
		<GenerateAssemblyProductAttribute>false</GenerateAssemblyProductAttribute>
		<GenerateAssemblyInformationalVersionAttribute>false</GenerateAssemblyInformationalVersionAttribute>
		<GenerateAssemblyFileVersionAttribute>false</GenerateAssemblyFileVersionAttribute>
		<GenerateAssemblyTitleVersionAttribute>false</GenerateAssemblyTitleVersionAttribute>
		<GenerateAssemblyTitleAttribute>false</GenerateAssemblyTitleAttribute>
		<GenerateAssemblyVersionAttribute>false</GenerateAssemblyVersionAttribute>
		<RunCodeAnalysis>false</RunCodeAnalysis>
		<IsTrimmable>true</IsTrimmable>
		<EnableTrimAnalyzer>true</EnableTrimAnalyzer>
		<IsAotCompatible>true</IsAotCompatible>
		<!-- The LibraryImport source generator emits unsafe marshalling code (SYSLIB1062). No hand-written unsafe blocks exist in this project. -->
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="DefaultDocumentation" Version="1.2.5" PrivateAssets="all" IncludeAssets="build" />
		<PackageReference Include="MimeKit" Version="4.17.0" />
		<PackageReference Include="StbImageSharp" Version="2.30.15" />
		<PackageReference Include="StbImageWriteSharp" Version="1.16.7" />
	</ItemGroup>
	<ItemGroup>
		<None Remove="PdfSharpCore\Resources\Messages.restext" />
		<EmbeddedResource Include="PdfSharpCore\Resources\Messages.restext" />
		<None Remove="Text\Resources\Patterns\*.br" />
		<EmbeddedResource Include="Text\Resources\Patterns\*.br" />
		<None Remove="Text\Resources\language-tags.txt" />
		<EmbeddedResource Include="Text\Resources\language-tags.txt" />
		<None Remove="Text\Resources\Bidi\*.br" />
		<EmbeddedResource Include="Text\Resources\Bidi\*.br" />
	</ItemGroup>
	<ItemGroup>
		<Folder Include="PdfSharpCore\Resources\images\" />
	</ItemGroup>
	<ItemGroup>
		<InternalsVisibleTo Include="PeachPDF.Tests" />
		<InternalsVisibleTo Include="PeachPDF.Cli" />
	</ItemGroup>
	<!--
		css-properties.json is the source of truth CssPropertyRegistry.g.cs / SvgPropertyRegistry.g.cs
		are generated from - see PeachPDF.SourceGenerators and CLAUDE.md's generator section. It's build
		input, not package content, so it's excluded from the implicit None/Pack glob and delivered to
		the analyzer only via AdditionalFiles (the schema file is editor-only tooling, left as plain None).
	-->
	<ItemGroup>
		<None Remove="css-properties.json" />
		<AdditionalFiles Include="css-properties.json" />
	</ItemGroup>
	<ItemGroup>
		<!--
			UndefineProperties strips the publish-time global properties dotnet publish/PublishAot=true set
			before they reach this reference - without it, they cascade into the referenced project graph
			even with ReferenceOutputAssembly="false", and PublishAot=true fails outright on netstandard2.0
			(NETSDK1207, "Ahead-of-time compilation is not supported for the target framework") when
			publishing PeachPDF.Cli, which references this project transitively.
		-->
		<ProjectReference Include="..\PeachPDF.SourceGenerators\PeachPDF.SourceGenerators.csproj"
			OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all"
			UndefineProperties="PublishAot;PublishTrimmed;PublishSingleFile;PublishReadyToRun;SelfContained;RuntimeIdentifier"
			SetTargetFramework="TargetFramework=netstandard2.0" />
	</ItemGroup>
	<ItemGroup>
		<None Include="..\..\README.md" Pack="true" PackagePath="\" />
		<None Include="..\..\docs\assets\img\peach.png" Pack="true" PackagePath="\" />
	</ItemGroup>
	<Target Name="GeneratePeachPdfProductInfo" BeforeTargets="BeforeBuild">
		<WriteLinesToFile File="$(IntermediateOutputPath)PeachPdfProductInfo.g.cs" Lines="namespace PeachPDF { internal static class PeachPdfProductInfo { public const string Generator = &quot;PeachPDF $(PackageVersion)&quot;%3B } }" Overwrite="true" />
		<ItemGroup>
			<Compile Include="$(IntermediateOutputPath)PeachPdfProductInfo.g.cs" />
		</ItemGroup>
	</Target>
</Project>

