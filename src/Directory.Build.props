<Project>
  <PropertyGroup>
    <!-- Every project builds for both supported runtimes. The .NET 11 SDK is required (global.json pins it);
         net10.0 stays a supported target, not a reason to build with the older SDK. -->
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <!-- The 11 SDK's latest language version (C# 15) for every target, so language-only features such as
         collection-expression arguments (`[with(comparer), ...]`) compile for net10.0 too. Features that
         need runtime types are still limited to what both targets have. -->
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- Runtime async (the runtime, not the compiler, suspends and resumes async methods) only exists on the
       .NET 11 runtime, so it is on for net11.0 targets only; net10.0 keeps the compiler's state machines. -->
  <PropertyGroup Condition="$(TargetFramework.StartsWith('net11.0'))">
    <Features>$(Features);runtime-async=on</Features>
  </PropertyGroup>

  <!-- IDE hosts that ignore global.json would otherwise fail later with an obscure NETSDK1045. -->
  <Target Name="RequireDotNet11Sdk" BeforeTargets="_CheckForUnsupportedTargetFramework;ResolveTargetingPackAssets;CoreCompile" Condition="'$(NETCoreSdkVersion)' != '' AND $([MSBuild]::VersionLessThan($(NETCoreSdkVersion), '11.0.100'))">
    <Error Text="Building PeachPDF requires the .NET 11 SDK (11.0.100 or newer); the SDK in use is $(NETCoreSdkVersion). Install it from https://dotnet.microsoft.com/download/dotnet/11.0 - see global.json." />
  </Target>
</Project>
